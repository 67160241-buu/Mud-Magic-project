rules_version = '2';

// Mud Magic: each signed-in user can only see and change their own designs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /designs/{designId} {
      function signedIn() { return request.auth != null; }
      function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }
      function validDesign(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 150
          && data.description is string && data.description.size() <= 500000;
      }

      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data) && validDesign(request.resource.data);
      allow update: if owns(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && validDesign(request.resource.data);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
