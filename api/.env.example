# Copy this file to .env before running docker compose up

POSTGRES_USER=project_user
POSTGRES_PASSWORD=project_pass
POSTGRES_DB=project_db

# Change this in production — used to sign JWT access/refresh tokens
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI — optional. Without it the AI design endpoint is disabled and
# the site falls back to its offline keyword generator.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
