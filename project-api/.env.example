# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าก่อนรันจริง (.env ห้าม commit ขึ้น git — ดู .gitignore)

POSTGRES_USER=projectuser
POSTGRES_PASSWORD=projectpass
POSTGRES_DB=projectdb

# ใช้คำสั่งนี้สร้างค่าสุ่มที่ปลอดภัย: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-to-a-long-random-secret

ACCESS_TOKEN_EXPIRE_MINUTES=60
