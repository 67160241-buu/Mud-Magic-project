{
  "name": "mud-magic",
  "version": "1.0.0",
  "private": true,
  "description": "Mud Magic ceramic design site on Cloudflare Workers + D1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mud-magic-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mud-magic-db --remote"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
