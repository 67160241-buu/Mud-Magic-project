# Copy to .dev.vars for `npx wrangler dev` (never commit .dev.vars).
# In production set these with: npx wrangler secret put <NAME>

# OpenAI key for /ai/* (optional — without it the site uses its offline generator)
OPENAI_API_KEY=

# Google OAuth client secret (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_SECRET=

# Optional: override vars from wrangler.jsonc locally
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OPENAI_MODEL=gpt-4o-mini
